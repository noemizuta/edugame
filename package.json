{
  "name": "edugame-ram",
  "version": "0.1.0",
  "private": true,
  "description": "EduGame RAM · Guardianes del Antibiótico (UNAC)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:api": "firebase emulators:exec --only auth,firestore --project edugame-ram \"vitest run --project api\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project edugame-ram \"playwright test\"",
    "emuladores": "firebase emulators:start --only auth,firestore",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "revision-contenido": "tsx --conditions=react-server scripts/revision-contenido.ts"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "next": "~16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "firebase-tools": "^15.36.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
