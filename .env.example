# Cliente (Firebase → Configuración del proyecto → Tus apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Servidor (Firebase → Configuración → Cuentas de servicio → Generar nueva clave privada)
# NUNCA subir al repositorio
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional: solo cuentas de estos dominios (p. ej. unac.edu.pe)
DOMINIOS_PERMITIDOS=

# URL pública del sitio (para el QR del afiche del aula)
NEXT_PUBLIC_URL_SITIO=

# true para usar los emuladores locales de Firebase
USE_FIREBASE_EMULATOR=
