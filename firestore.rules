rules_version = '2';
// EduGame RAM: el navegador NO accede a Firestore.
// Toda lectura y escritura pasa por la API de Next.js con firebase-admin,
// que ignora estas reglas y aplica los permisos por rol en el servidor.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
